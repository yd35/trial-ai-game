<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nz.ac.auckland.se206.controllers.RationaleController">

  <children>
      <Rectangle arcHeight="5.0" arcWidth="5.0" height="600.0" stroke="BLACK" strokeType="INSIDE" width="801.0" />

    <!-- Title -->
    <Text fx:id="titleText" fill="WHITE" layoutX="194.0" layoutY="55.0" text="Provide Your Rationale" AnchorPane.leftAnchor="194.0" AnchorPane.rightAnchor="175.60000000000002" AnchorPane.topAnchor="28.0">
      <font><Font size="36.0" url="@../fonts/04B_03__.TTF" /></font>
    </Text>

    <!-- Timer visuals (top-right, no logic here) -->
    <Rectangle fx:id="timerOutline" arcHeight="5.0" arcWidth="5.0" fill="#bcbcbc" height="64.0" stroke="BLACK" strokeWidth="0.0" width="92.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
    <Text fx:id="timerText" text="1:00" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
      <font><Font size="36.0" url="@../fonts/alagard.ttf" /></font>
    </Text>

    <!-- Chat display -->
    <TextArea fx:id="chatTextArea" editable="false" styleClass="chat-box" stylesheets="@../css/chat.css" wrapText="true" AnchorPane.bottomAnchor="90.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="80.0">
         <font>
            <Font size="16.0" url="@../fonts/04B_03__.TTF" />
         </font></TextArea>

    <!-- Input row -->
    <HBox spacing="10" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
      <children>
        <TextField fx:id="textField" onAction="#onSendMessage" prefHeight="52.0" prefWidth="561.0" promptText="Type your rationale..." styleClass="chat-box" stylesheets="@../css/chat.css" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="16.0" url="@../fonts/04B_03__.TTF" />
               </font></TextField> <!-- Enter will fire send -->
        <Button fx:id="sendButton" onAction="#onSendMessage" prefHeight="52.0" prefWidth="83.0" styleClass="outline-btn" stylesheets="@../css/style.css" text="Send">
               <font>
                  <Font size="16.0" url="@../fonts/04B_03__.TTF" />
               </font></Button>
        <Region HBox.hgrow="ALWAYS" />
        <!-- Continue is disabled until a response is graded -->
        <Button fx:id="continueButton" disable="true" onAction="#onContinue" prefHeight="51.0" prefWidth="118.0" styleClass="outline-btn" stylesheets="@../css/style.css" text="Continue">
               <font>
                  <Font size="16.0" url="@../fonts/04B_03__.TTF" />
               </font></Button>
      </children>
    </HBox>

  </children>
</AnchorPane>
