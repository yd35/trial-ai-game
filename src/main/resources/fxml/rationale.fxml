<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="nz.ac.auckland.se206.controllers.RationaleController">

  <children>

    <!-- Title -->
    <Text fx:id="titleText" text="Provide Your Rationale"
          AnchorPane.topAnchor="15.0" AnchorPane.leftAnchor="160.0" AnchorPane.rightAnchor="160.0">
      <font><Font size="36.0"/></font>
    </Text>

    <!-- Timer visuals (top-right, no logic here) -->
    <Rectangle fx:id="timerOutline" width="92.0" height="64.0" fill="#bcbcbc" stroke="BLACK" strokeWidth="0.0"
               arcWidth="5.0" arcHeight="5.0"
               AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"/>
    <Text fx:id="timerText" text="1:00"
          AnchorPane.topAnchor="10.0" AnchorPane.rightAnchor="10.0">
      <font><Font size="36.0"/></font>
    </Text>

    <!-- Chat display -->
    <TextArea fx:id="chatTextArea" editable="false" wrapText="true"
              AnchorPane.topAnchor="80.0" AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0" AnchorPane.bottomAnchor="90.0"/>

    <!-- Input row -->
    <HBox spacing="10" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.bottomAnchor="20.0">
      <children>
        <TextField fx:id="textField" HBox.hgrow="ALWAYS" promptText="Type your rationale..."
                   onAction="#sendMessage"/> <!-- Enter will fire send -->
        <Button fx:id="sendButton" text="Send" onAction="#sendMessage"/>
        <Region HBox.hgrow="ALWAYS"/>
        <!-- Continue is disabled until a response is graded -->
        <Button fx:id="continueButton" text="Continue" disable="true" onAction="#onContinue"/>
      </children>
    </HBox>

  </children>
</AnchorPane>
